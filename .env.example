# Bharat Guardian AI - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SATELLITE & WEATHER APIs
# ============================================

# NASA FIRMS (Fire detection)
# Get key from: https://earthdata.nasa.gov/
VITE_NASA_API_KEY=your_nasa_api_key_here

# ISRO Bhuvan (Indian satellite data)
# Get key from: https://bhuvan.nrsc.gov.in/
VITE_ISRO_API_KEY=your_isro_api_key_here

# OpenWeatherMap (Weather predictions)
# Get key from: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# ============================================
# MAPPING & ROUTING
# ============================================

# Google Maps API (Directions, Places)
# Get key from: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Mapbox (Alternative mapping)
# Get token from: https://account.mapbox.com/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# ============================================
# COMPUTER VISION
# ============================================

# Azure Face API (Face recognition for missing persons)
# Get key from: https://portal.azure.com/
VITE_AZURE_FACE_KEY=your_azure_face_api_key_here
VITE_AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# ============================================
# COMMUNICATION
# ============================================

# Twilio (Phone calls, SMS)
# Get from: https://www.twilio.com/console
VITE_TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE_NUMBER=+91xxxxxxxxxx

# ============================================
# BACKEND SERVICES
# ============================================

# Your Backend API URL
VITE_BACKEND_URL=http://localhost:8000
VITE_BACKEND_API_KEY=your_backend_api_key_here

# ============================================
# DATABASE
# ============================================

# PostgreSQL Connection (if using direct connection from frontend - not recommended)
VITE_DATABASE_URL=postgresql://user:password@localhost:5432/bharat_guardian

# ============================================
# FEATURE FLAGS
# ============================================

# Enable/disable features
VITE_ENABLE_OFFLINE_MESH=true
VITE_ENABLE_FACE_RECOGNITION=true
VITE_ENABLE_DAMAGE_REPORTS=true
VITE_ENABLE_CROWD_DETECTION=true

# ============================================
# MONITORING & ANALYTICS
# ============================================

# Sentry (Error tracking)
VITE_SENTRY_DSN=your_sentry_dsn_here

# LogRocket (Session replay)
VITE_LOGROCKET_ID=your_logrocket_id_here

# ============================================
# DEVELOPMENT
# ============================================

# Environment
VITE_ENV=development  # development | staging | production

# Debug mode
VITE_DEBUG=false

# Mock API responses (for testing)
VITE_USE_MOCK_API=true

# ============================================
# SECURITY
# ============================================

# CORS allowed origins
VITE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Encryption key for sensitive data
VITE_ENCRYPTION_KEY=your_encryption_key_here_minimum_32_chars
